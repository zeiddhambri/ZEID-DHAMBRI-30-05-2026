# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase integration credentials
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ---- Durcissement P0 (voir docs/ANALYSE-PRESENTATION-INSTITUTIONS-FINANCIERES.md) ----
# Secret de signature des jetons applicatifs (>= 32 caractères). Requis en production ;
# à défaut un secret est auto-généré dans data/.auth-secret (sessions invalidées au restart).
APP_AUTH_SECRET=""
# Origines autorisées pour le CORS (séparées par des virgules). Ex : https://app.ma-banque.tn
ALLOWED_ORIGINS=""
# Comptes de démonstration du backend (à remplacer par le SSO de l'institution en pilote) :
#   agent@recovai.tn / directeur@recovai.tn / admin@recovai.tn
DEMO_AGENT_PASSWORD=""
DEMO_MANAGER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
# Instance de présentation isolée : autoriser le jeton 'demo-mode-token' côté serveur...
ALLOW_DEMO_TOKEN="0"
# ...et afficher les boutons + bandeau de démonstration côté client (mettre '1' uniquement
# sur l'environnement de démo, JAMAIS en build de production destiné aux clients).
VITE_DEMO_MODE="0"

# --- Persistance (lot P1) ---
# Laisser vide = store JSON de démonstration. Définir pour activer Postgres
# (RLS multi-institution, audit append-only, verrou optimiste).
DATABASE_URL=""
# Mot de passe par défaut du rôle applicatif créé par la migration (à changer au déploiement).
# APP_DB_PASSWORD=change_me_in_deployment

# --- Confidentialité des flux IA (lot P1.4) ---
# on (défaut) : les prompts envoyés au modèle sont pseudonymisés côté serveur.
# off : réservé aux déploiements où le LLM est dans le périmètre de l'institution.
AI_REDACT="on"

# Mot de passe commun des comptes de démo cloisonnés (agent.amen/agent.tunisiemf).
DEMO_TENANT_PASSWORD=""

# Répertoire du store JSON (défaut : ./data). Utilisé par les tests.
RECOVAI_DATA_DIR=""
