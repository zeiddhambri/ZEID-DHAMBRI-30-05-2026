# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase integration credentials
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ---- Durcissement P0 (voir docs/ANALYSE-PRESENTATION-INSTITUTIONS-FINANCIERES.md) ----
# Secret de signature des jetons applicatifs (>= 32 caractères). Requis en production ;
# à défaut un secret est auto-généré dans data/.auth-secret (sessions invalidées au restart).
APP_AUTH_SECRET=""
# Origines autorisées pour le CORS (séparées par des virgules). Ex : https://app.ma-banque.tn
ALLOWED_ORIGINS=""
# Comptes de démonstration du backend (à remplacer par le SSO de l'institution en pilote) :
#   agent@recovai.tn / directeur@recovai.tn / admin@recovai.tn
DEMO_AGENT_PASSWORD=""
DEMO_MANAGER_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
# Instance de présentation isolée : autoriser le jeton 'demo-mode-token' côté serveur...
ALLOW_DEMO_TOKEN="0"
# ...et afficher les boutons + bandeau de démonstration côté client (mettre '1' uniquement
# sur l'environnement de démo, JAMAIS en build de production destiné aux clients).
VITE_DEMO_MODE="0"

# --- Persistance (lot P1) ---
# Laisser vide = store JSON de démonstration. Définir pour activer Postgres
# (RLS multi-institution, audit append-only, verrou optimiste).
DATABASE_URL=""
# Mot de passe par défaut du rôle applicatif créé par la migration (à changer au déploiement).
# APP_DB_PASSWORD=change_me_in_deployment

# --- Confidentialité des flux IA (lot P1.4) ---
# on (défaut) : les prompts envoyés au modèle sont pseudonymisés côté serveur.
# off : réservé aux déploiements où le LLM est dans le périmètre de l'institution.
AI_REDACT="on"

# Mot de passe commun des comptes de démo cloisonnés (agent.amen/agent.tunisiemf).
DEMO_TENANT_PASSWORD=""

# Répertoire du store JSON (défaut : ./data). Utilisé par les tests.
RECOVAI_DATA_DIR=""

# --- P1.5 : Connecteurs de communication réels ---
# SMS_PROVIDER: console (démo, journalisé) | http (agrégateur tunisien) | twilio | orange_tn | ooredoo_tn
SMS_PROVIDER="console"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER="RecovAI"
# EMAIL_PROVIDER: console | smtp | sendgrid | mailgun
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="0"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@recovai.tn"
WHATSAPP_PROVIDER="console"
# Secret partagé pour HMAC des webhooks SMS/Email/WhatsApp (P1.5)
COMM_WEBHOOK_SECRET=""

# --- P1.7 : SSO & MFA TOTP + session courte + lockout ---
AUTH_ACCESS_TTL_SECONDS="900"
AUTH_REFRESH_TTL_SECONDS="604800"
AUTH_MAX_FAILURES="5"
AUTH_FAILURE_WINDOW_MS="900000"
AUTH_LOCKOUT_BASE_MS="900000"
AUTH_LOCKOUT_MAX_MS="7200000"
MFA_ENFORCED_ROLES="admin,manager"
# OIDC (Entra ID / Okta) — stub P1.7, à compléter pour flux réel
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email groups"
SAML_IDP_METADATA_URL=""
SCIM_ENABLED="0"
SCIM_TOKEN=""
